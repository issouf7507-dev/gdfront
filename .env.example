# URL publique du site
NEXT_PUBLIC_SITE_URL=https://gdcouverture.ci

# MySQL local du Mac (root requis par prisma migrate dev pour la base shadow)
DATABASE_URL="mysql://root:<mot-de-passe>@localhost:3306/gdcouv"
# Sel pour le hachage des IP (anti-spam) — valeur aléatoire en production
IP_HASH_SALT=

# Resend (serveur uniquement — ne jamais préfixer par NEXT_PUBLIC_)
RESEND_API_KEY=
FROM_EMAIL="GD Couverture <contact@gdcouverture.ci>"

# Google Analytics 4 (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=
# Google Ads (AW-XXXXXXX) et libellés de conversion (AW-XXXXXXX/abcDEF)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_SEND_TO=
NEXT_PUBLIC_GOOGLE_ADS_CALL_SEND_TO=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_SEND_TO=

# WhatsApp au format international sans "+" (défaut : numéro du site)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Better Auth (secret : openssl rand -base64 32)
BETTER_AUTH_SECRET=
# URL publique du site (en local : http://localhost:3001)
BETTER_AUTH_URL=https://gdcouverture.ci

# Dossier des images uploadées (hors du dossier du build, à sauvegarder)
UPLOAD_DIR=./storage/uploads

# Compte admin créé par `pnpm db:seed` (ou pnpm admin:create)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
