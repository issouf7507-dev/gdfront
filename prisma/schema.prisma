generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum QuoteStatus {
  NOUVEAU
  CONTACTE
  DEVIS_ENVOYE
  GAGNE
  PERDU
}

model QuoteRequest {
  id      String      @id @default(cuid())
  name    String      @db.VarChar(100)
  email   String      @db.VarChar(200)
  phone   String      @db.VarChar(30)
  company String?     @db.VarChar(150)
  service String      @db.VarChar(50)
  message String      @db.Text
  status  QuoteStatus @default(NOUVEAU)
  notes   String?     @db.Text

  // Provenance (voir lib/analytics.ts)
  utmSource   String? @db.VarChar(300)
  utmMedium   String? @db.VarChar(300)
  utmCampaign String? @db.VarChar(300)
  utmTerm     String? @db.VarChar(300)
  utmContent  String? @db.VarChar(300)
  gclid       String? @db.VarChar(300)
  landingPage String? @db.VarChar(300)
  referrer    String? @db.VarChar(300)

  // Empreinte hachée de l'IP, uniquement pour la limitation anti-spam
  ipHash    String? @db.Char(64)
  emailSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([ipHash, createdAt])
}

// Rôles du back-office (droits détaillés dans lib/roles.ts)
enum UserRole {
  ADMIN
  EDITEUR
}

model User {
  id            String    @id
  name          String    @db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  role          UserRole  @default(EDITEUR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId(length: 191)])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId(length: 191)])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Contenu géré depuis l'admin
// ---------------------------------------------------------------------------

// Image uploadée (convertie en WebP, stockée dans UPLOAD_DIR, servie par /uploads/...)
model Media {
  id           String   @id @default(cuid())
  path         String   @unique @db.VarChar(191) // ex. 2026/09/abc123.webp
  originalName String   @db.VarChar(255)
  alt          String?  @db.VarChar(255)
  width        Int
  height       Int
  size         Int
  createdAt    DateTime @default(now())

  realisationCovers Realisation[]      @relation("RealisationCover")
  realisationImages RealisationImage[]
  articleCovers     Article[]          @relation("ArticleCover")
}

model Realisation {
  id          String             @id @default(cuid())
  title       String             @db.VarChar(150)
  slug        String             @unique @db.VarChar(180)
  location    String?            @db.VarChar(150)
  service     String             @db.VarChar(50)
  description String             @db.Text
  published   Boolean            @default(false)
  completedAt DateTime?
  coverId     String?
  cover       Media?             @relation("RealisationCover", fields: [coverId], references: [id], onDelete: SetNull)
  images      RealisationImage[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([published, createdAt])
}

enum RealisationImageKind {
  AVANT
  APRES
  GALERIE
}

model RealisationImage {
  id            String               @id @default(cuid())
  realisationId String
  realisation   Realisation          @relation(fields: [realisationId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media                @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  kind          RealisationImageKind @default(GALERIE)
  position      Int                  @default(0)

  @@index([realisationId, position])
}

enum ArticleStatus {
  BROUILLON
  PUBLIE
}

model Article {
  id             String        @id @default(cuid())
  title          String        @db.VarChar(200)
  slug           String        @unique @db.VarChar(180)
  excerpt        String?       @db.VarChar(500)
  content        String        @db.LongText // HTML nettoyé (sanitize-html)
  category       String?       @db.VarChar(100)
  seoTitle       String?       @db.VarChar(200)
  seoDescription String?       @db.VarChar(300)
  status         ArticleStatus @default(BROUILLON)
  publishedAt    DateTime?
  coverId        String?
  cover          Media?        @relation("ArticleCover", fields: [coverId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  role      String?  @db.VarChar(150) // ex. "Syndic, Cocody"
  content   String   @db.Text
  rating    Int      @default(5)
  published Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
}
